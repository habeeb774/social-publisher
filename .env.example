DATABASE_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
CRON_SECRET=
PUBLISHING_ENABLED=false
DEFAULT_TIMEZONE=Asia/Riyadh
WINDSOR_MCP_URL=https://mcp.windsor.ai/
WINDSOR_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=

# Meta OAuth (Facebook/Instagram) — مجاني
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# ---- Movie reels (local dev defaults; no real secrets) ----
MOVIE_REELS_ENABLED=false
# Keep false. Enable only after tests pass, rights are verified and the owner gives final approval.
MOVIE_REELS_PUBLISHING_ENABLED=false
# mock = record publications locally, never calls Meta. Use meta only in production.
MOVIE_PUBLISH_DRIVER=mock
# >=32 chars, shared with the worker. Generate: openssl rand -hex 32
MOVIE_WORKER_SECRET=
# Storage: s3 (MinIO/R2/S3/B2/Wasabi...) or local (filesystem, dev only)
MOVIE_STORAGE_DRIVER=s3
MOVIE_LOCAL_STORAGE_DIR=.movie-storage
# Required (>=32 chars) when MOVIE_STORAGE_DRIVER=local. Generate: openssl rand -hex 32
MOVIE_LOCAL_STORAGE_SECRET=
# Local MinIO from docker-compose.movies.yml
MOVIE_S3_ENDPOINT=http://localhost:9000
MOVIE_S3_REGION=us-east-1
MOVIE_S3_BUCKET=movie-reels
MOVIE_S3_ACCESS_KEY_ID=minio-dev
MOVIE_S3_SECRET_ACCESS_KEY=minio-dev-password-change-me
MOVIE_S3_FORCE_PATH_STYLE=true
