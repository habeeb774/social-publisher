# Copy to worker.env (same folder). Never commit worker.env. No quotes around values.
MOVIE_API_URL=https://sp.leanpix.site
# Must equal MOVIE_WORKER_SECRET in Vercel; at least 32 characters.
MOVIE_WORKER_SECRET=
MOVIE_WORKER_ID=windows-worker-1
MOVIE_ALLOW_INSECURE_API=0
MOVIE_POLL_SECONDS=30
MOVIE_CLIP_SELECTION=highlights
MOVIE_HIGHLIGHT_MODEL=qwen2.5vl:3b
MOVIE_HIGHLIGHT_URL=http://vision:11434
MOVIE_HIGHLIGHT_MAX_CLIPS=20
MOVIE_HIGHLIGHT_MIN_SCORE=6
